---
interface Props {
  series: {
    key: string;
    title: string;
    eyebrow: string;
    description: string;
    color: string;
    index: string;
  };
  count: number;
}

const { series, count } = Astro.props;
---

<article class:list={["series-card", `accent-${series.color}`]}>
  <a href={`/series/${series.key}/`}>
    <div class="series-card-head">
      <span>{series.index}</span>
      <span class="series-pulse"><i></i>{count} POSTS</span>
    </div>
    <div>
      <span class="eyebrow">{series.eyebrow}</span>
      <h3>{series.title}</h3>
      <p>{series.description}</p>
    </div>
    <span class="series-action">进入专题 <i aria-hidden="true">→</i></span>
  </a>
</article>

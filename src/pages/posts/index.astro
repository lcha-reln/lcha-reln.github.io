---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SERIES } from "../../config";
import { formatDate, getExcerpt, getPostPath, getSeries, sortPosts } from "../../lib/content";

const posts = sortPosts(await getCollection("posts", ({ data }) => !data.draft));
---

<BaseLayout title="文章归档" description="全部技术文章：实时消息、分布式系统、高性能组件与交易系统。">
  <header class="page-hero">
    <span class="eyebrow">ALL TRANSMISSIONS / {String(posts.length).padStart(2, "0")}</span>
    <h1>文章归档</h1>
    <p>按时间浏览全部技术笔记。每篇文章都保留稳定链接，适合收藏、引用与持续更新。</p>
  </header>

  <section class="section">
    <div class="archive-toolbar">
      <p>共 {posts.length} 篇文章，按发布时间倒序排列。</p>
      <nav class="filter-chips" aria-label="按专题浏览">
        <a href="/posts/" aria-current="page">全部</a>
        {SERIES.map((series) => <a href={`/series/${series.key}/`}>{series.title}</a>)}
      </nav>
    </div>

    <div class="post-list">
      {posts.map((post, index) => {
        const series = getSeries(post);
        return (
          <a class="post-row" href={getPostPath(post)}>
            <span class="post-row-index">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h2>{post.data.title}</h2>
              <p>{getExcerpt(post, 100)}</p>
            </div>
            <span class="post-row-series">{series.title}</span>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>

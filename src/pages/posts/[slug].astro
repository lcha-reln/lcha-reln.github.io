---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import MermaidRuntime from "../../components/MermaidRuntime.astro";
import "../../styles/prose.css";
import {
  formatDate,
  getExcerpt,
  getPostPath,
  getPostSlug,
  getPostsInSeries,
  getSeries,
  normalizeList,
  readingMinutes,
} from "../../lib/content";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post, allPosts: posts },
  }));
}

interface Props {
  post: CollectionEntry<"posts">;
  allPosts: CollectionEntry<"posts">[];
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);
const series = getSeries(post);
const seriesPosts = getPostsInSeries(allPosts, series.key);
const currentIndex = seriesPosts.findIndex((entry) => entry.id === post.id);
const newer = currentIndex > 0 ? seriesPosts[currentIndex - 1] : undefined;
const older = currentIndex >= 0 && currentIndex < seriesPosts.length - 1 ? seriesPosts[currentIndex + 1] : undefined;
const tags = normalizeList(post.data.tags);
const categories = normalizeList(post.data.categories);
const description = getExcerpt(post, 160);
const editUrl = `https://github.com/lcha-reln/lcha-reln.github.io/edit/source/src/content/posts/${post.id}`;
const seriesPath = series.key === "meta" ? "/about/" : `/series/${series.key}/`;
---

<BaseLayout title={post.data.title} description={description} canonical={new URL(getPostPath(post), Astro.site).toString()} article>
  <div class="reading-progress" data-reading-progress aria-hidden="true"></div>

  <header class="article-hero">
    <div class="article-crumbs">
      <a href={seriesPath}>{series.title}</a>
      <span>/</span>
      <span>{series.eyebrow}</span>
    </div>
    <h1>{post.data.title}</h1>
    <p class="article-lead">{description}</p>
    <div class="article-meta">
      <span><i></i> 发布于 <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></span>
      {post.data.updated && <span>更新于 {formatDate(post.data.updated)}</span>}
      <span>{readingMinutes(post)} 分钟阅读</span>
      <span>{headings.filter((heading) => heading.depth === 2).length} 个章节</span>
    </div>
  </header>

  <div class="article-shell">
    <TableOfContents headings={headings} />

    <article class="article-body">
      <Content />
    </article>

    <aside class="article-aside" aria-label="文章信息">
      <dl>
        <div><dt>SERIES</dt><dd>{series.title}</dd></div>
        <div><dt>ROUTE</dt><dd>/{getPostSlug(post)}</dd></div>
        {categories.length > 0 && <div><dt>CATEGORY</dt><dd>{categories.join(" / ")}</dd></div>}
        <div><dt>SOURCE</dt><dd><a href={editUrl} target="_blank" rel="noreferrer">EDIT ON GITHUB ↗</a></dd></div>
      </dl>
    </aside>

    <footer class="article-footer">
      {tags.length > 0 && (
        <div class="article-tags" aria-label="文章标签">
          {tags.map((tag) => <span>#{tag}</span>)}
        </div>
      )}
      {(newer || older) && (
        <nav class="article-nav" aria-label="同专题上一篇与下一篇">
          {older ? (
            <a href={getPostPath(older)}><small>← PREVIOUS</small><strong>{older.data.title}</strong></a>
          ) : <span></span>}
          {newer && (
            <a href={getPostPath(newer)}><small>NEXT →</small><strong>{newer.data.title}</strong></a>
          )}
        </nav>
      )}
    </footer>
  </div>

  <MermaidRuntime />

  <script>
    const progress = document.querySelector<HTMLElement>("[data-reading-progress]");
    function updateProgress() {
      if (!progress) return;
      const article = document.querySelector<HTMLElement>(".article-body");
      if (!article) return;
      const start = article.offsetTop;
      const distance = article.offsetHeight - window.innerHeight;
      const value = distance > 0 ? Math.min(1, Math.max(0, (window.scrollY - start + 120) / distance)) : 1;
      progress.style.width = `${value * 100}%`;
    }
    updateProgress();
    window.addEventListener("scroll", updateProgress, { passive: true });
    window.addEventListener("resize", updateProgress);
  </script>
</BaseLayout>
